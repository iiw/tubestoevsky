# Local application configuration (do not commit)

# LLM endpoint: any OpenAI-compatible chat completions API
# (/v1 is appended automatically when the URL has no path)
LLM_BASE_URL=http://127.0.0.1:4000
LLM_API_KEY=fill_in_api_key
LLM_MODEL=gpt-6-luna

# Default subtitle language (2-letter locale: en, de, fr, ...)
TRANSCRIPT_LANG=en

# Output directory (defaults to the current one)
OUTPUT_DIR=.

# LLM parameters
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=1800

# Optional yt-dlp settings (if YouTube requires authorization):
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=safari

# Preferred global configuration:
# tubestoevsky config set LLM_API_KEY=sk-xxxxx
# Environment variables always override ~/.tubestoevsky/config.yaml.
