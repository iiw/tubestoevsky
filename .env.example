# Local application configuration (do not commit)

# LiteLLM router (proxy to your models)
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=fill_in_master_key
LITELLM_MODEL=glm-5-3

# Default subtitle language (2-letter locale: fr, de, en, ...)
TRANSCRIPT_LANG=en

# Output directory (defaults to the current one)
OUTPUT_DIR=.

# LLM parameters
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=1800

# Optional yt-dlp settings (if YouTube requires authorization):
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=safari
